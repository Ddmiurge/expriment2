+def _cache_has_tokens(pkv) -> bool:
+    """判断 past_key_values 是否已经装了 token。
+
+    transformers 4.57+ 的 generate 会把一个**空的** DynamicCache 传进来（不是 None），
+    直接判 `is not None` 会让 prefill 也被当成 decode 步、剪枝永远不触发。
+    """
+    if pkv is None:
+        return False
+    getter = getattr(pkv, "get_seq_length", None)
+    if callable(getter):
+        try:
+            return int(getter()) > 0
+        except Exception:  # noqa: BLE001
+            return True
+    if isinstance(pkv, (tuple, list)):
+        return bool(pkv) and pkv[0] is not None
+    return True
+
+
